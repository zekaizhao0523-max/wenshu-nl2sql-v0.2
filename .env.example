# 问数平台 — 本地开发配置（勿提交真实密码）

# ---------- 原始业务库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=demo_business
MYSQL_USER=demo_user
MYSQL_PASSWORD=change_me

# RAW 可与上面相同；不填则继承 MYSQL_*
# RAW_MYSQL_DATABASE=demo_business

# ---------- L1/L2 元数据库 ----------
META_MYSQL_HOST=127.0.0.1
META_MYSQL_PORT=3306
META_MYSQL_DATABASE=demo_metadata
META_MYSQL_USER=demo_meta
META_MYSQL_PASSWORD=change_me

# META_MYSQL_DSN=mysql+pymysql://user:pass@127.0.0.1:3306/demo_metadata

# ---------- Qdrant ----------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=wenshu_knowledge
# QDRANT_API_KEY=

# ---------- Embedding（本地）----------
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
LOCAL_EMBEDDING_DEVICE=cpu

# ---------- LLM（Ollama / OpenAI 兼容）----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# ---------- Schema 召回 ----------
SCHEMA_KEYWORD_MODE=auto
SCHEMA_INTENT_MODE=rule
SCHEMA_CLARIFY_GATE=1
SCHEMA_COLUMN_SELECT=1

# ---------- Agent（默认对齐 icecoding M7→M8→M10 图重试）----------
AGENT_APPROVAL_ENABLED=1
AGENT_SKIP_SANDBOX=0
AGENT_SQL_TIMEOUT_MS=30000
AGENT_SQL_MAX_ROWS=200
# M7 首轮多候选（AST 打分，非执行聚类）
AGENT_SQL_MULTI_CANDIDATE=1
AGENT_SQL_CANDIDATE_COUNT=2
# 可选 XiYan 流程：S1/S2 双 schema + 执行聚类选优（非 icecoding 默认）
# AGENT_SQL_XIYAN_PIPELINE=0
# AGENT_SQL_EXEC_SELECT=0
# AGENT_SQL_ENSEMBLE_LLM=
# AGENT_PLAN_LLM=0
# AGENT_SQL_LLM=0
# AGENT_RESULT_SUMMARY_MODE=auto
# AGENT_DATA_SCOPE=
# AGENT_EXPLAIN_ROW_THRESHOLD=1000000
# 完整说明见 docs/配置与参数说明.md
